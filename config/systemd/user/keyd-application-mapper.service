[Unit]
Description=Keyd Application Mapper
After=graphical-session.target

[Service]
# No -d here: that daemonizes and the parent exits immediately, which Type=simple
# reads as the service dying. Restart=always then burns through the start limit
# and the unit ends up failed. Let systemd supervise it in the foreground instead.
Type=simple
ExecStart=/usr/bin/keyd-application-mapper
Restart=always
RestartSec=2

[Install]
WantedBy=default.target